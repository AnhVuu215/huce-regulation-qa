# Khóa API Gemini (Google AI Studio). Bắt buộc để trả lời câu hỏi.
GEMINI_API_KEY=
# Mô hình trả lời, cách nhau bởi dấu phẩy: mô hình đầu hết lượt trong ngày thì dùng mô hình sau.
# Gói miễn phí: gemini-3.6-flash chỉ 20 lượt/ngày.
LLM_MODEL=gemini-3.5-flash-lite,gemini-3.6-flash
# Cổng trên máy khi chạy bằng docker compose.
APP_PORT=8000
